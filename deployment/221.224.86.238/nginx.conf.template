# Use only after checking existing server_name and listener ownership.
server {
    listen 80;
    server_name 221.224.86.238;
    server_tokens off;
    client_max_body_size 16m;

    # Keep legacy port-80 bookmarks on the canonical browser origin.
    if ($http_host ~ "^221[.]224[.]86[.]238(:80)?$") {
        return 302 http://221.224.86.238:800$request_uri;
    }

    location / {
        proxy_pass http://127.0.0.1:14310;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
    }
}
